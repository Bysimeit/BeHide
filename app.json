{
  "expo": {
    "name": "BeHide",
    "slug": "behide",
    "owner": "bysimeit",
    "version": "1.1.0",
    "scheme": "behide",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "be.behide.app"
    },
    "android": {
      "package": "be.behide.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00ABB6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00ABB6"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BeHide utilise Face ID pour déverrouiller votre identité sur cet appareil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BeHide utilise la caméra pour les appels vidéo, pour scanner le QR code d'un contact et pour prendre les photos et vidéos que vous envoyez."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-sqlite",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "BeHide utilise la caméra pour les appels vidéo, pour scanner le QR code d'un contact et pour prendre les photos et vidéos que vous envoyez.",
          "microphonePermission": "BeHide utilise le micro pour les appels audio et vidéo, et pour le son des vidéos que vous enregistrez."
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "BeHide accède à vos photos pour les joindre à un message, chiffrées de bout en bout."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "01bf37c4-9129-49c9-b303-1492ea29a59e"
      }
    }
  }
}
